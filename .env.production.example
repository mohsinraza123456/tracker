# Copy this to ".env" on the VPS (docker-compose.prod.yml reads it) and fill in
# every placeholder — do not deploy with these example values.

# --- Postgres (used by the db container; DATABASE_URL below must match) ---
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=tracker

# "db" is the Postgres container's hostname on the compose network, not "localhost".
DATABASE_URL=postgresql+psycopg2://tracker:change-me-to-a-long-random-password@db:5432/tracker

# Real public URL — used to build tracking links and the OG/canonical tags.
BASE_URL=https://clicktracker.yourselfmedia.com

# Break-glass login that always works alongside registered users (see /register).
# Do not deploy with the defaults from .env.example.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Signs session cookies. Generate one and keep it fixed — rotating it logs everyone
# out. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Repeat clicks from the same campaign+IP+User-Agent within this many seconds are
# flagged as duplicates and excluded from stats/cost.
DEDUPE_WINDOW_SECONDS=10
