DATABASE_URL=postgresql+psycopg2://tracker:tracker@localhost:5432/tracker
BASE_URL=http://localhost:8000

# Login for the dashboard/admin UI. Change these before exposing the app beyond localhost.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Signs session cookies. Set a fixed random value so sessions survive app restarts;
# generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Repeat clicks from the same campaign+IP+User-Agent within this many seconds are
# flagged as duplicates and excluded from stats/cost.
DEDUPE_WINDOW_SECONDS=10
